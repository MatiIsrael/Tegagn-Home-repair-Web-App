# ==============================================================================
# TEGAGN BACKEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your server or configure in your PaaS Dashboard (Render/Railway).
# NEVER commit the real .env file into Git source control!
# ==============================================================================

# 1. Django Core Security
# Generate a strong key using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-in-production-to-a-very-secure-random-string-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=api.tegagn.com,tegagn-backend.onrender.com,localhost,127.0.0.1

# 2. Supabase PostgreSQL Connection
# Direct Connection (Port 5432 - For running migrations):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Transaction Pooler Connection (Port 6543 - Recommended for Web Server / Gunicorn):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=0
USE_SQLITE_FALLBACK=False

# 3. CORS & CSRF Whitelist (Strictly restricted to frontend origin)
CORS_ALLOWED_ORIGINS=https://tegagn.com,https://www.tegagn.com,https://tegagn.vercel.app
CSRF_TRUSTED_ORIGINS=https://tegagn.com,https://www.tegagn.com,https://tegagn.vercel.app

# 4. HTTPS & Security Headers
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# 5. JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# 6. Initial Administrator Automated Provisioning (Optional for CI/CD)
INITIAL_ADMIN_EMAIL=admin@tegagn.com
INITIAL_ADMIN_PHONE=+251911000000
INITIAL_ADMIN_PASSWORD=SetAStrongRandomPassword123!
