# ==============================================================================
# TEGAGN FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or set in Vercel / Netlify dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD DATABASE CONFIGURATION (RECOMMENDED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Get your project URL and anon key from: https://app.supabase.com -> Project Settings -> API
# Run supabase/schema.sql in the Supabase SQL Editor to initialize all tables and RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. OPTIONAL PYTHON DJANGO REST API BASE URL
# ------------------------------------------------------------------------------
# Local Development: http://localhost:8000/api/v1
# Production: https://api.tegagn.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1
